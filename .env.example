# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Spring Boot does not read .env itself; load it into your shell before running:
#   set -a; . ./.env; set +a; ./gradlew bootRun
#
# Tests and `./gradlew build` need none of these: they use Koog's mock executor.

# LLM provider keys (step 2+). A blank key leaves that provider unconfigured.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Opt-in for live (paid) LLM calls. While this is false or unset, the Koog Anthropic/OpenAI
# executors are not created even when the keys above are set, and /api/v1/agent/chat returns 503.
APP_AGENT_LIVE_LLM=false
